# Every variable the backend reads. Copy to .env and fill in the values.
# Never commit .env.

# --- Gemini ---
GEMINI_API_KEY=
# true: canned answers instead of real Gemini calls (no quota used)
USE_MOCK_GEMINI=

# --- Supabase ---
# Project Settings -> API -> Project URL
# (also used to fetch the JWKS for verifying sign-ins, see app/core/auth.py)
SUPABASE_URL=
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=
# Project Settings -> API Keys -> secret (or service_role) key. Backend only:
# never in the frontend. Used for image storage and the seed tool's logins.
SUPABASE_SERVICE_ROLE_KEY=

# --- Image storage (app/core/storage.py) ---
# Empty: images stay in backend/uploads. A private bucket's name
# (e.g. sketch-images): images go to Supabase Storage.
STORAGE_BUCKET=
# Optional: where the server keeps its scratch copies (default: the temp folder)
STORAGE_CACHE_DIR=

# --- Signed image links (app/core/media.py) ---
# A long random string. Keep it the same across restarts, or every open
# image link stops working.
MEDIA_SIGNING_KEY=

# --- The public site (production only) ---
# Comma separated, e.g. https://sketchconnect.web.app
FRONTEND_ORIGINS=

# --- Debugging and testing ---
# true: print every Gemini prompt, schema and response, and show the raw
# response in the browser's debug panel
DEBUG=
# true: print how many database queries each request made
QUERY_LOG=
# true, testing only: relaxed rules for event tagging
RELAXED_EVENT_RULES=

# --- Seed tool (tools/seed_test_data.py) ---
# The password every seed sketcher signs in with (8 or more characters)
SEED_PASSWORD=
